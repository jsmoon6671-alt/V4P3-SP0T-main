# Discord bot / database
BOT_TOKEN=
DATABASE_URL=postgresql://user:password@host:5432/database

# Website
WEB_STORE_ENABLED=true
WEB_GUILD_ID=123456789012345678
WEB_PUBLIC_URL=https://shop.example.com
WEB_HOST=0.0.0.0
# Railway에서는 PORT가 자동 입력됩니다.
WEB_PORT=8080
WEB_SESSION_SECRET=32자_이상의_무작위_문자열
# 관리자 패널 비밀번호입니다. 배포 후에는 원하는 값으로 변경할 수 있습니다.
WEB_ADMIN_PASSWORD=tb9988230..

# Discord OAuth2 (Redirect URL: https://shop.example.com/auth/callback)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://shop.example.com/auth/callback

# Pushbullet automatic payment approval
PUSHBULLET_ACCESS_TOKEN=
# 선택: 은행 앱 패키지만 쉼표로 제한. 비워 두면 모든 앱의 입금형 알림을 검사합니다.
PUSHBULLET_ALLOWED_PACKAGES=
# 선택: 은행 알림 문구가 기본 형식과 다를 때 사용합니다.
# 반드시 name, amount named group을 포함해야 합니다.
# PUSHBULLET_DEPOSIT_REGEX=(?P<name>[가-힣]{2,10}).*?(?P<amount>[0-9][0-9,]*)\s*원
